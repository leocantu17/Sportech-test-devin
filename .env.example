# SQLite local. Para producción: postgresql://user:pass@host:5432/db (y provider = "postgresql" en schema.prisma)
DATABASE_URL="file:./dev.db"

# Secreto para firmar la cookie de sesión (mínimo 32 caracteres). Genera uno con: openssl rand -base64 32
AUTH_SECRET="cambia-este-secreto-por-uno-largo-y-aleatorio-123456"

# Muestra el recuadro de credenciales de prueba en /login (solo entorno demo)
DEMO_MODE="true"

# Origen permitido para POST /api/leads desde la landing B2B (CORS). "*" permite cualquiera.
LEADS_ALLOWED_ORIGIN="*"
