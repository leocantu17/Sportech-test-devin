# PostgreSQL. Local: el de docker-compose.yml. En Vercel + Neon estas dos variables las crea la integración.
# DATABASE_URL: conexión con pooling (la usa la app). DATABASE_URL_UNPOOLED: conexión directa (la usan las migraciones).
DATABASE_URL="postgresql://sportech:sportech@localhost:5432/sportech_crm"
DATABASE_URL_UNPOOLED="postgresql://sportech:sportech@localhost:5432/sportech_crm"

# Secreto para firmar la cookie de sesión (mínimo 32 caracteres). Genera uno con: openssl rand -base64 32
AUTH_SECRET="cambia-este-secreto-por-uno-largo-y-aleatorio-123456"

# Muestra el recuadro de credenciales de prueba en /login (solo entorno demo)
DEMO_MODE="true"

# Origen permitido para POST /api/leads desde la landing B2B (CORS). "*" permite cualquiera.
LEADS_ALLOWED_ORIGIN="*"
